{
  "name": "AnimalIndividual",
  "type": "object",
  "properties": {
    "individual_code": {
      "type": "string",
      "title": "Individual Code"
    },
    "nickname": {
      "type": "string",
      "title": "Nickname / Local ID"
    },
    "species": {
      "type": "string",
      "title": "Species ID"
    },
    "species_name": {
      "type": "string",
      "title": "Species Name"
    },
    "scientific_name": {
      "type": "string",
      "title": "Scientific Name"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "confirmed",
        "pending",
        "unverified"
      ],
      "default": "confirmed"
    },
    "reference_photos": {
      "type": "array",
      "title": "Reference Photos (private file_uris)",
      "items": {
        "type": "string"
      }
    },
    "feature_signature": {
      "type": "object",
      "title": "LLM Feature Signature",
      "properties": {
        "pattern_type": {
          "type": "string"
        },
        "distinguishing_marks": {
          "type": "string"
        },
        "body_condition": {
          "type": "string"
        },
        "estimated_age_class": {
          "type": "string"
        },
        "sex": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "embedding_vector": {
      "type": "array",
      "title": "Embedding Vector (future external model)",
      "items": {
        "type": "number"
      }
    },
    "sighting_count": {
      "type": "number",
      "title": "Sighting Count",
      "default": 0
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time",
      "title": "First Seen At"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Seen At"
    },
    "last_location": {
      "type": "string",
      "title": "Last Location"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "sensitive_location": {
      "type": "boolean",
      "title": "Sensitive Location (hide exact coords)",
      "default": false
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "individual_code",
    "species"
  ]
}