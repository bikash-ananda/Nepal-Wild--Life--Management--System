{
  "name": "CameraPreset",
  "type": "object",
  "properties": {
    "camera_id": {
      "type": "string",
      "title": "Camera ID",
      "ref": "Camera"
    },
    "camera_name": {
      "type": "string",
      "title": "Camera Name"
    },
    "name": {
      "type": "string",
      "title": "Preset Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "preset_index": {
      "type": "number",
      "title": "Preset Index",
      "default": 1
    },
    "pan": {
      "type": "number",
      "title": "Pan Position"
    },
    "tilt": {
      "type": "number",
      "title": "Tilt Position"
    },
    "zoom": {
      "type": "number",
      "title": "Zoom",
      "default": 1
    }
  },
  "required": [
    "camera_id",
    "name"
  ]
}