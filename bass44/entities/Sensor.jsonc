{
  "name": "Sensor",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "title": "Device ID"
    },
    "name": {
      "type": "string",
      "title": "Sensor Name"
    },
    "site_id": {
      "type": "string",
      "title": "Site ID",
      "ref": "Site"
    },
    "site_name": {
      "type": "string",
      "title": "Site Name"
    },
    "sensor_type": {
      "type": "string",
      "enum": [
        "ultrasonic",
        "pir_motion",
        "microwave_radar",
        "light",
        "temperature",
        "humidity",
        "rain",
        "wind",
        "gps",
        "sound",
        "rf_detector",
        "custom"
      ],
      "default": "pir_motion"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "calibrating"
      ],
      "default": "online"
    },
    "signal_strength": {
      "type": "number",
      "title": "Signal Strength (%)",
      "default": 100
    },
    "battery_level": {
      "type": "number",
      "title": "Battery Level (%)",
      "default": 100
    },
    "calibration_value": {
      "type": "number",
      "title": "Calibration Value"
    },
    "last_reading": {
      "type": "number",
      "title": "Last Reading"
    },
    "last_reading_unit": {
      "type": "string",
      "title": "Unit"
    },
    "last_reading_time": {
      "type": "string",
      "format": "date-time",
      "title": "Last Reading Time"
    }
  },
  "required": [
    "name",
    "site_id",
    "sensor_type"
  ]
}