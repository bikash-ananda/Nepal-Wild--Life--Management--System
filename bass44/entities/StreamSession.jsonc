{
  "name": "StreamSession",
  "type": "object",
  "properties": {
    "camera_id": {
      "type": "string",
      "title": "Camera ID",
      "ref": "Camera"
    },
    "camera_name": {
      "type": "string",
      "title": "Camera Name"
    },
    "session_token": {
      "type": "string",
      "title": "Session Token"
    },
    "stream_type": {
      "type": "string",
      "title": "Stream Type",
      "enum": [
        "main",
        "sub"
      ],
      "default": "main"
    },
    "stream_path": {
      "type": "string",
      "title": "Gateway Stream Path"
    },
    "whep_endpoint": {
      "type": "string",
      "title": "WebRTC WHEP Endpoint URL"
    },
    "ice_servers": {
      "type": "array",
      "title": "ICE Servers",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "title": "Session Status",
      "enum": [
        "active",
        "expired",
        "failed",
        "closed"
      ],
      "default": "active"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expires At"
    },
    "client_ip": {
      "type": "string",
      "title": "Client IP"
    }
  },
  "required": [
    "camera_id",
    "session_token"
  ]
}