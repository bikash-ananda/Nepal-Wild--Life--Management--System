{
  "name": "HwcCase",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "title": "Case ID"
    },
    "conflict_type": {
      "type": "string",
      "title": "Conflict Type",
      "enum": [
        "crop_damage",
        "livestock_attack",
        "human_injury",
        "human_death",
        "property_damage",
        "wildlife_settlement",
        "wildlife_agriculture",
        "other"
      ],
      "default": "crop_damage"
    },
    "species": {
      "type": "string",
      "title": "Species"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "location_name": {
      "type": "string",
      "title": "Location / Area"
    },
    "affected_area": {
      "type": "string",
      "title": "Affected Area (GeoJSON polygon)"
    },
    "reported_by": {
      "type": "string",
      "title": "Reporter ID"
    },
    "reporter_name": {
      "type": "string",
      "title": "Reporter Name"
    },
    "reporter_role": {
      "type": "string",
      "title": "Reporter Role"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "videos": {
      "type": "array",
      "title": "Videos",
      "items": {
        "type": "string"
      }
    },
    "estimated_damage": {
      "type": "string",
      "title": "Estimated Damage (NPR)"
    },
    "affected_crop": {
      "type": "string",
      "title": "Affected Crop"
    },
    "affected_livestock": {
      "type": "string",
      "title": "Affected Livestock"
    },
    "livestock_count": {
      "type": "number",
      "title": "Livestock Count",
      "default": 0
    },
    "human_casualties": {
      "type": "string",
      "title": "Human Casualties"
    },
    "urgency": {
      "type": "string",
      "title": "Urgency",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "reported",
        "verified",
        "assigned",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "reported"
    },
    "assigned_officer": {
      "type": "string",
      "title": "Assigned Officer"
    },
    "response_team": {
      "type": "string",
      "title": "Response Team"
    },
    "resolution": {
      "type": "string",
      "title": "Resolution"
    },
    "verified_by": {
      "type": "string",
      "title": "Verified By"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Verified At"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "title": "Occurred At"
    },
    "is_demo": {
      "type": "boolean",
      "title": "Demo Record",
      "default": false
    }
  },
  "required": [
    "conflict_type",
    "urgency"
  ]
}