{
  "name": "ClassificationVote",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "string",
      "title": "Verification Sample ID"
    },
    "player_id": {
      "type": "string",
      "title": "Player User ID"
    },
    "player_name": {
      "type": "string",
      "title": "Player Display Name"
    },
    "player_email": {
      "type": "string",
      "title": "Player Email"
    },
    "voted_label": {
      "type": "string",
      "title": "Voted Species Label"
    },
    "training_comment": {
      "type": "string",
      "title": "Training Text Comment"
    },
    "is_correct": {
      "type": "boolean",
      "title": "Matched Confirmed Label",
      "default": false
    },
    "points_awarded": {
      "type": "number",
      "title": "Points Awarded",
      "default": 0
    },
    "difficulty_tier": {
      "type": "string",
      "title": "Difficulty Tier",
      "enum": [
        "common",
        "rare",
        "escalated"
      ],
      "default": "common"
    },
    "game_mode": {
      "type": "string",
      "title": "Game Mode",
      "enum": [
        "hint_shown",
        "hint_hidden"
      ],
      "default": "hint_shown"
    },
    "awarded_at": {
      "type": "string",
      "format": "date-time",
      "title": "Awarded At (set once confirmed)"
    }
  },
  "required": [
    "sample_id",
    "player_id",
    "voted_label"
  ]
}