{
  "name": "Device",
  "type": "object",
  "properties": {
    "device_uuid": {
      "type": "string",
      "title": "Device UUID"
    },
    "name": {
      "type": "string",
      "title": "Device Name"
    },
    "device_type": {
      "type": "string",
      "title": "Device Type"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "gateway",
        "camera",
        "sensor",
        "deterrent",
        "relay",
        "actuator",
        "other"
      ],
      "default": "other"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "brand": {
      "type": "string",
      "title": "Brand"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "firmware_version": {
      "type": "string",
      "title": "Firmware Version"
    },
    "hardware_version": {
      "type": "string",
      "title": "Hardware Version"
    },
    "operating_system": {
      "type": "string",
      "title": "Operating System"
    },
    "mac_address": {
      "type": "string",
      "title": "MAC Address"
    },
    "ip_address": {
      "type": "string",
      "title": "IP Address"
    },
    "gateway_address": {
      "type": "string",
      "title": "Gateway Address"
    },
    "protocol": {
      "type": "string",
      "title": "Communication Protocol"
    },
    "auth_method": {
      "type": "string",
      "title": "Authentication Method"
    },
    "username": {
      "type": "string",
      "title": "Username"
    },
    "encrypted_password": {
      "type": "string",
      "title": "Encrypted Password"
    },
    "api_token": {
      "type": "string",
      "title": "API Token"
    },
    "ssl_certificate": {
      "type": "string",
      "title": "SSL Certificate"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "installation_address": {
      "type": "string",
      "title": "Installation Address"
    },
    "site_id": {
      "type": "string",
      "title": "Site / Project",
      "ref": "Site"
    },
    "site_name": {
      "type": "string",
      "title": "Site Name"
    },
    "power_source": {
      "type": "string",
      "title": "Power Source",
      "enum": [
        "AC",
        "DC",
        "Solar",
        "Battery",
        "PoE",
        "Hybrid"
      ],
      "default": "AC"
    },
    "voltage": {
      "type": "number",
      "title": "Voltage (V)"
    },
    "battery_level": {
      "type": "number",
      "title": "Battery Level (%)",
      "default": 100
    },
    "solar_status": {
      "type": "string",
      "title": "Solar Status"
    },
    "signal_strength": {
      "type": "number",
      "title": "Signal Strength (%)",
      "default": 100
    },
    "network_quality": {
      "type": "string",
      "title": "Network Quality",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor",
        "none"
      ],
      "default": "good"
    },
    "last_online": {
      "type": "string",
      "format": "date-time",
      "title": "Last Online"
    },
    "last_offline": {
      "type": "string",
      "format": "date-time",
      "title": "Last Offline"
    },
    "health_score": {
      "type": "number",
      "title": "Health Score (0-100)",
      "default": 100
    },
    "error_status": {
      "type": "string",
      "title": "Error Status"
    },
    "warning_status": {
      "type": "string",
      "title": "Warning Status"
    },
    "ai_capability": {
      "type": "boolean",
      "title": "AI Capability",
      "default": false
    },
    "ai_model_version": {
      "type": "string",
      "title": "AI Model Version"
    },
    "storage_capacity_gb": {
      "type": "number",
      "title": "Storage Capacity (GB)"
    },
    "available_storage_gb": {
      "type": "number",
      "title": "Available Storage (GB)"
    },
    "cpu_usage": {
      "type": "number",
      "title": "CPU Usage (%)",
      "default": 0
    },
    "ram_usage": {
      "type": "number",
      "title": "RAM Usage (%)",
      "default": 0
    },
    "temperature_c": {
      "type": "number",
      "title": "Temperature (\u00b0C)",
      "default": 0
    },
    "uptime_hours": {
      "type": "number",
      "title": "Uptime (hours)",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "installation_date": {
      "type": "string",
      "format": "date",
      "title": "Installation Date"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date",
      "title": "Warranty Expiry"
    },
    "maintenance_schedule": {
      "type": "string",
      "title": "Maintenance Schedule"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "online",
        "offline",
        "warning",
        "fault",
        "disabled",
        "maintenance"
      ],
      "default": "online"
    },
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": true
    }
  },
  "required": [
    "name",
    "device_type"
  ]
}