{
  "name": "DeviceLog",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "title": "Device ID",
      "ref": "Device"
    },
    "device_name": {
      "type": "string",
      "title": "Device Name"
    },
    "log_type": {
      "type": "string",
      "title": "Log Type",
      "enum": [
        "info",
        "warning",
        "error",
        "action",
        "health",
        "connection",
        "firmware"
      ],
      "default": "info"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "details": {
      "type": "string",
      "title": "Details"
    },
    "user_name": {
      "type": "string",
      "title": "User"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Timestamp"
    }
  },
  "required": [
    "device_id",
    "log_type",
    "message"
  ]
}