{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "profile_image_url": {
      "type": "string",
      "title": "Profile Image URL"
    },
    "phone_number": {
      "type": "string",
      "title": "Phone Number"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "enum": [
        "Wildlife Officer",
        "Field Officer",
        "Project Manager",
        "IoT Technician",
        "AI/ML Specialist",
        "GIS Specialist",
        "Researcher",
        "Farm Coordinator",
        "Administrator",
        "Field Worker",
        "Observer"
      ],
      "default": "Field Officer"
    },
    "department": {
      "type": "string",
      "title": "Department / Team"
    },
    "assigned_location": {
      "type": "string",
      "title": "Assigned Location",
      "description": "Province / District / Municipality / Ward"
    },
    "assigned_farm_ids": {
      "type": "array",
      "title": "Assigned Farm IDs",
      "items": {
        "type": "string"
      }
    },
    "assigned_farm_names": {
      "type": "array",
      "title": "Assigned Farm Names",
      "items": {
        "type": "string"
      }
    },
    "assigned_device_ids": {
      "type": "array",
      "title": "Assigned Device IDs",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive",
        "on_leave",
        "disabled"
      ],
      "default": "active"
    },
    "bio": {
      "type": "string",
      "title": "Short Bio / Designation"
    },
    "permissions": {
      "type": "array",
      "title": "Permissions",
      "items": {
        "type": "string",
        "enum": [
          "view_dashboard",
          "manage_team",
          "manage_devices",
          "manage_farms",
          "manage_alerts",
          "trigger_deterrents",
          "manage_api_keys",
          "manage_integrations",
          "view_analytics",
          "view_reports"
        ]
      }
    },
    "alerts_handled": {
      "type": "number",
      "title": "Alerts Handled",
      "default": 0
    },
    "incidents_handled": {
      "type": "number",
      "title": "Wildlife Incidents Handled",
      "default": 0
    },
    "is_demo": {
      "type": "boolean",
      "title": "Demo / Prototype Record",
      "default": false
    },
    "total_points": {
      "type": "number",
      "title": "Game Total Points",
      "default": 0
    },
    "game_level": {
      "type": "number",
      "title": "Game Level",
      "default": 1
    },
    "game_title": {
      "type": "string",
      "title": "Game Title",
      "default": "Rookie"
    },
    "verified_count": {
      "type": "number",
      "title": "Game Verified Count",
      "default": 0
    },
    "correct_count": {
      "type": "number",
      "title": "Game Correct Count",
      "default": 0
    },
    "accuracy_pct": {
      "type": "number",
      "title": "Game Accuracy %",
      "default": 0
    },
    "current_streak": {
      "type": "number",
      "title": "Current Streak",
      "default": 0
    },
    "best_streak": {
      "type": "number",
      "title": "Best Streak",
      "default": 0
    },
    "weekly_points": {
      "type": "number",
      "title": "Weekly Points",
      "default": 0
    },
    "game_badges": {
      "type": "array",
      "title": "Earned Game Badges",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "full_name",
    "role"
  ]
}