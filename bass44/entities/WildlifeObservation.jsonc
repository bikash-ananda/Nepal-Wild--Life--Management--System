{
  "name": "WildlifeObservation",
  "type": "object",
  "properties": {
    "observation_id": {
      "type": "string",
      "title": "Observation ID"
    },
    "species": {
      "type": "string",
      "title": "Species"
    },
    "species_name": {
      "type": "string",
      "title": "Species Name"
    },
    "count": {
      "type": "number",
      "title": "Number Observed",
      "default": 1
    },
    "observation_type": {
      "type": "string",
      "title": "Observation Type",
      "enum": [
        "individual",
        "group",
        "tracks",
        "footprints",
        "droppings",
        "nest",
        "feeding_sign",
        "other"
      ],
      "default": "individual"
    },
    "behavior": {
      "type": "string",
      "title": "Behavior"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "location_name": {
      "type": "string",
      "title": "Location / Area"
    },
    "province": {
      "type": "string",
      "title": "Province"
    },
    "district": {
      "type": "string",
      "title": "District"
    },
    "ward": {
      "type": "string",
      "title": "Ward / Municipality"
    },
    "source": {
      "type": "string",
      "title": "Submission Source",
      "enum": [
        "officer",
        "public",
        "camera_inference"
      ],
      "default": "officer"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "observed_by": {
      "type": "string",
      "title": "Observer ID"
    },
    "observer_name": {
      "type": "string",
      "title": "Observer Name"
    },
    "patrol_id": {
      "type": "string",
      "title": "Related Patrol ID"
    },
    "verified": {
      "type": "boolean",
      "title": "Verified",
      "default": false
    },
    "verified_by": {
      "type": "string",
      "title": "Verified By"
    },
    "individual_id": {
      "type": "string",
      "title": "Identified Individual ID"
    },
    "match_confidence": {
      "type": "number",
      "title": "Individual Match Confidence (0-1)"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Observed At"
    },
    "is_demo": {
      "type": "boolean",
      "title": "Demo Record",
      "default": false
    }
  },
  "required": [
    "species",
    "count"
  ]
}