{
  "name": "Patrol",
  "type": "object",
  "properties": {
    "patrol_id": {
      "type": "string",
      "title": "Patrol ID"
    },
    "name": {
      "type": "string",
      "title": "Patrol Name"
    },
    "sector": {
      "type": "string",
      "title": "Sector"
    },
    "park_id": {
      "type": "string",
      "title": "Protected Area ID",
      "ref": "Site"
    },
    "park_name": {
      "type": "string",
      "title": "Protected Area Name"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "planned",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "planned"
    },
    "assigned_rangers": {
      "type": "array",
      "title": "Assigned Rangers",
      "items": {
        "type": "string"
      }
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "title": "End Time"
    },
    "planned_route": {
      "type": "array",
      "title": "Planned Route",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "actual_route": {
      "type": "array",
      "title": "Actual GPS Route",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "distance_km": {
      "type": "number",
      "title": "Distance (km)",
      "default": 0
    },
    "duration_hours": {
      "type": "number",
      "title": "Duration (hours)",
      "default": 0
    },
    "objectives": {
      "type": "string",
      "title": "Objectives"
    },
    "notes": {
      "type": "string",
      "title": "Patrol Notes"
    },
    "incidents_discovered": {
      "type": "number",
      "title": "Incidents Discovered",
      "default": 0
    },
    "sightings_count": {
      "type": "number",
      "title": "Wildlife Sightings",
      "default": 0
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    },
    "is_demo": {
      "type": "boolean",
      "title": "Demo Record",
      "default": false
    }
  },
  "required": [
    "name",
    "sector"
  ]
}