{
  "name": "Species",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "English Name"
    },
    "nepali_name": {
      "type": "string",
      "title": "Nepali Name"
    },
    "scientific_name": {
      "type": "string",
      "title": "Scientific Name"
    },
    "local_names": {
      "type": "string",
      "title": "Local / Common Names"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "wildlife",
        "livestock",
        "human",
        "pest",
        "other"
      ],
      "default": "wildlife"
    },
    "taxonomic_class": {
      "type": "string",
      "title": "Taxonomic Class",
      "enum": [
        "mammal",
        "bird",
        "reptile",
        "amphibian",
        "fish",
        "invertebrate",
        "other"
      ],
      "default": "mammal"
    },
    "conservation_status": {
      "type": "string",
      "title": "Conservation Status",
      "enum": [
        "least_concern",
        "near_threatened",
        "vulnerable",
        "endangered",
        "critically_endangered",
        "extinct_wild",
        "extinct",
        "data_deficient",
        "not_evaluated"
      ],
      "default": "least_concern"
    },
    "protected_status": {
      "type": "string",
      "title": "Protected Status",
      "enum": [
        "protected",
        "partly_protected",
        "unprotected",
        "game",
        "invasive"
      ],
      "default": "unprotected"
    },
    "habitat": {
      "type": "string",
      "title": "Habitat"
    },
    "distribution": {
      "type": "string",
      "title": "Distribution"
    },
    "typical_behavior": {
      "type": "string",
      "title": "Typical Behavior"
    },
    "threats": {
      "type": "string",
      "title": "Threats"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "image_url": {
      "type": "string",
      "title": "Reference Image URL"
    },
    "sample_count": {
      "type": "number",
      "title": "Sample Count",
      "default": 0
    },
    "response_rules": {
      "type": "string",
      "title": "Response Rules"
    },
    "assigned_deterrents": {
      "type": "array",
      "title": "Assigned Deterrents",
      "items": {
        "type": "string"
      }
    },
    "detection_threshold": {
      "type": "number",
      "title": "Detection Threshold (0-1)",
      "default": 0.7
    },
    "model_status": {
      "type": "string",
      "title": "Model Status",
      "enum": [
        "not_trained",
        "training",
        "trained",
        "deployed"
      ],
      "default": "not_trained"
    },
    "sensitive_location": {
      "type": "boolean",
      "title": "Sensitive Location (hide exact coords)",
      "default": false
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name",
    "category"
  ]
}