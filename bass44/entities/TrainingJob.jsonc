{
  "name": "TrainingJob",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Job Name"
    },
    "model_version": {
      "type": "string",
      "title": "Target Model Version"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "collecting",
        "balancing",
        "validating",
        "training",
        "evaluating",
        "completed",
        "failed",
        "scheduled"
      ],
      "default": "collecting"
    },
    "progress": {
      "type": "number",
      "title": "Progress (0-100)",
      "default": 0
    },
    "samples_collected": {
      "type": "number",
      "title": "Samples Collected",
      "default": 0
    },
    "duplicates_removed": {
      "type": "number",
      "title": "Duplicates Removed",
      "default": 0
    },
    "low_quality_removed": {
      "type": "number",
      "title": "Low Quality Removed",
      "default": 0
    },
    "quality_validated": {
      "type": "number",
      "title": "Quality Validated",
      "default": 0
    },
    "class_distribution": {
      "type": "object",
      "title": "Class Distribution"
    },
    "imbalance_detected": {
      "type": "boolean",
      "title": "Class Imbalance Detected",
      "default": false
    },
    "accuracy": {
      "type": "number",
      "title": "Accuracy (%)",
      "default": 0
    },
    "false_positive_rate": {
      "type": "number",
      "title": "False Positive Rate (%)",
      "default": 0
    },
    "previous_model_version": {
      "type": "string",
      "title": "Previous Model Version"
    },
    "previous_accuracy": {
      "type": "number",
      "title": "Previous Accuracy (%)",
      "default": 0
    },
    "comparison_result": {
      "type": "string",
      "title": "Comparison Result",
      "enum": [
        "improved",
        "degraded",
        "neutral"
      ],
      "default": "improved"
    },
    "accuracy_delta": {
      "type": "number",
      "title": "Accuracy Delta",
      "default": 0
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "changelog": {
      "type": "string",
      "title": "Changelog"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "title": "Scheduled At"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Started At"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At"
    }
  },
  "required": [
    "name",
    "model_version"
  ]
}