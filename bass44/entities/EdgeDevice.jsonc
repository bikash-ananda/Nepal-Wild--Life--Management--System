{
  "name": "EdgeDevice",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "title": "Device ID"
    },
    "name": {
      "type": "string",
      "title": "Device Name"
    },
    "site_id": {
      "type": "string",
      "title": "Site ID",
      "ref": "Site"
    },
    "site_name": {
      "type": "string",
      "title": "Site Name"
    },
    "hardware": {
      "type": "string",
      "title": "Hardware",
      "default": "Raspberry Pi 4B"
    },
    "os_version": {
      "type": "string",
      "title": "OS Version",
      "default": "Raspberry Pi OS"
    },
    "ai_version": {
      "type": "string",
      "title": "AI Model Version",
      "default": "yolov8n-v1.0"
    },
    "online_status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "degraded"
      ],
      "default": "online"
    },
    "cpu_usage": {
      "type": "number",
      "title": "CPU Usage (%)",
      "default": 0
    },
    "memory_usage": {
      "type": "number",
      "title": "Memory Usage (%)",
      "default": 0
    },
    "storage_usage": {
      "type": "number",
      "title": "Storage Usage (%)",
      "default": 0
    },
    "temperature_c": {
      "type": "number",
      "title": "Temperature (\u00b0C)",
      "default": 0
    },
    "last_communication": {
      "type": "string",
      "format": "date-time",
      "title": "Last Communication"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "failed"
      ],
      "default": "synced"
    }
  },
  "required": [
    "name",
    "site_id"
  ]
}