{
  "name": "Camera",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Camera Name"
    },
    "camera_id": {
      "type": "string",
      "title": "Camera ID"
    },
    "site_id": {
      "type": "string",
      "title": "Site ID",
      "ref": "Site"
    },
    "site_name": {
      "type": "string",
      "title": "Site Name"
    },
    "brand": {
      "type": "string",
      "title": "Brand",
      "default": "Dahua"
    },
    "model": {
      "type": "string",
      "title": "Model",
      "default": "Dahua Hero H3A"
    },
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "rtsp_url": {
      "type": "string",
      "title": "RTSP URL",
      "description": "Full RTSP URL. Credentials may be embedded or stored separately."
    },
    "main_stream_url": {
      "type": "string",
      "title": "Main Stream URL",
      "description": "High-quality main stream RTSP URL used for live view, recording, evidence."
    },
    "sub_stream_url": {
      "type": "string",
      "title": "Sub-stream URL",
      "description": "Low-resolution sub-stream RTSP URL used for continuous AI detection / preview."
    },
    "ip_address": {
      "type": "string",
      "title": "IP Address / Hostname"
    },
    "camera_port": {
      "type": "number",
      "title": "Camera Port",
      "default": 80
    },
    "rtsp_port": {
      "type": "number",
      "title": "RTSP Port",
      "default": 554
    },
    "http_port": {
      "type": "number",
      "title": "HTTP Port",
      "default": 80
    },
    "https_port": {
      "type": "number",
      "title": "HTTPS Port",
      "default": 443
    },
    "username": {
      "type": "string",
      "title": "Camera Username"
    },
    "encrypted_password": {
      "type": "string",
      "title": "Encrypted Password",
      "description": "Obfuscated server-side. Never exposed to the frontend in plain text."
    },
    "last_credential_update": {
      "type": "string",
      "format": "date-time",
      "title": "Last Credential Update"
    },
    "onvif_support": {
      "type": "boolean",
      "default": true
    },
    "codec": {
      "type": "string",
      "title": "Video Codec",
      "enum": [
        "H.264",
        "H.265",
        "MJPEG",
        "auto"
      ],
      "default": "H.264"
    },
    "resolution": {
      "type": "string",
      "title": "Resolution",
      "description": "e.g. 1920x1080"
    },
    "fps": {
      "type": "number",
      "title": "Configured FPS",
      "default": 20
    },
    "bitrate_kbps": {
      "type": "number",
      "title": "Bitrate (kbps)",
      "default": 2048
    },
    "ptz_support": {
      "type": "boolean",
      "title": "PTZ Support",
      "default": false
    },
    "night_vision": {
      "type": "boolean",
      "title": "Night Vision",
      "default": true
    },
    "audio_enabled": {
      "type": "boolean",
      "title": "Audio Enabled",
      "default": false
    },
    "orientation": {
      "type": "string",
      "title": "Camera Orientation",
      "description": "e.g. North-facing, 45\u00b0 down"
    },
    "detection_zones": {
      "type": "array",
      "title": "Detection Zones",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "gateway_stream_id": {
      "type": "string",
      "title": "Gateway Stream ID / Path"
    },
    "webrtc_enabled": {
      "type": "boolean",
      "title": "WebRTC Enabled",
      "default": true
    },
    "recording_enabled": {
      "type": "boolean",
      "title": "Recording Enabled",
      "default": false
    },
    "ai_detection": {
      "type": "boolean",
      "default": true
    },
    "ai_detection_fps": {
      "type": "number",
      "title": "AI Detection FPS",
      "default": 5
    },
    "ai_status": {
      "type": "string",
      "title": "AI Processing Status",
      "enum": [
        "idle",
        "processing",
        "error",
        "disabled"
      ],
      "default": "idle"
    },
    "edge_device_id": {
      "type": "string",
      "title": "Connected Edge Device ID",
      "ref": "Device"
    },
    "edge_device_name": {
      "type": "string",
      "title": "Connected Edge Device Name"
    },
    "location_name": {
      "type": "string",
      "title": "Location Name"
    },
    "farm_name": {
      "type": "string",
      "title": "Farm Name"
    },
    "province": {
      "type": "string",
      "title": "Province"
    },
    "district": {
      "type": "string",
      "title": "District"
    },
    "municipality": {
      "type": "string",
      "title": "Municipality"
    },
    "ward": {
      "type": "string",
      "title": "Ward"
    },
    "settlement": {
      "type": "string",
      "title": "Settlement"
    },
    "installation_description": {
      "type": "string",
      "title": "Installation Description"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "router_name": {
      "type": "string",
      "title": "Router Name"
    },
    "router_ip": {
      "type": "string",
      "title": "Router IP"
    },
    "connection_type": {
      "type": "string",
      "title": "Router Connection Type",
      "enum": [
        "wifi",
        "ethernet",
        "4g_5g",
        "fiber"
      ],
      "default": "wifi"
    },
    "access_method": {
      "type": "string",
      "title": "Remote Access Method",
      "enum": [
        "static_ip",
        "dynamic_ip",
        "ddns",
        "port_forwarding",
        "vpn",
        "cloud_relay"
      ],
      "default": "ddns"
    },
    "external_host": {
      "type": "string",
      "title": "External Host / DDNS"
    },
    "external_rtsp_port": {
      "type": "number",
      "title": "External RTSP Port"
    },
    "external_http_port": {
      "type": "number",
      "title": "External HTTP Port"
    },
    "ddns_hostname": {
      "type": "string",
      "title": "DDNS Hostname"
    },
    "network_quality": {
      "type": "string",
      "title": "Network Quality",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor",
        "none"
      ],
      "default": "good"
    },
    "stream_status": {
      "type": "string",
      "title": "Stream Status",
      "enum": [
        "online",
        "connecting",
        "offline",
        "error"
      ],
      "default": "offline"
    },
    "latency_ms": {
      "type": "number",
      "title": "Stream Latency (ms)",
      "default": 0
    },
    "last_frame_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Frame At"
    },
    "last_detection_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Animal Detection At"
    },
    "last_detection_type": {
      "type": "string",
      "title": "Last Animal Detected"
    },
    "last_screenshot_url": {
      "type": "string",
      "title": "Last Screenshot URL"
    },
    "last_screenshot_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Screenshot At"
    },
    "last_successful_connection": {
      "type": "string",
      "format": "date-time",
      "title": "Last Successful Connection"
    },
    "last_failed_connection": {
      "type": "string",
      "format": "date-time",
      "title": "Last Failed Connection"
    },
    "last_error": {
      "type": "string",
      "title": "Last Error Message"
    },
    "installation_date": {
      "type": "string",
      "format": "date",
      "title": "Installation Date"
    },
    "firmware_version": {
      "type": "string",
      "title": "Firmware Version",
      "default": "1.0.0"
    },
    "motion_detection": {
      "type": "boolean",
      "default": true
    },
    "online_status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "degraded"
      ],
      "default": "online"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "warning",
        "critical"
      ],
      "default": "healthy"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time",
      "title": "Last Heartbeat"
    },
    "last_inspection": {
      "type": "string",
      "format": "date",
      "title": "Last Inspection"
    },
    "technician": {
      "type": "string",
      "title": "Technician"
    },
    "maintenance_notes": {
      "type": "string",
      "title": "Maintenance Notes"
    },
    "next_maintenance_date": {
      "type": "string",
      "format": "date",
      "title": "Next Maintenance Date"
    },
    "is_demo": {
      "type": "boolean",
      "title": "Demo / Prototype Record",
      "default": false
    }
  },
  "required": [
    "name",
    "site_id"
  ]
}