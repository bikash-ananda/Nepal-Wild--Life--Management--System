{
  "name": "ResponseProtocol",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Protocol Name"
    },
    "level": {
      "type": "number",
      "title": "Response Level",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "default": 0
    },
    "level_name": {
      "type": "string",
      "title": "Level Name",
      "enum": [
        "Monitoring",
        "Early Warning",
        "Prevention",
        "Active Response",
        "Emergency"
      ],
      "default": "Monitoring"
    },
    "site_id": {
      "type": "string",
      "title": "Site ID",
      "ref": "Site"
    },
    "site_name": {
      "type": "string",
      "title": "Site Name"
    },
    "detection_type": {
      "type": "string",
      "enum": [
        "monkey",
        "animal",
        "human",
        "vehicle",
        "wild_boar",
        "elephant",
        "leopard",
        "bear",
        "livestock"
      ],
      "default": "monkey"
    },
    "trigger_conditions": {
      "type": "string",
      "title": "Trigger Conditions"
    },
    "actions": {
      "type": "array",
      "title": "Response Actions",
      "items": {
        "type": "string"
      }
    },
    "notification_channels": {
      "type": "array",
      "title": "Notification Channels",
      "items": {
        "type": "string"
      }
    },
    "auto_escalate_after_seconds": {
      "type": "number",
      "title": "Auto Escalate After (s)",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name",
    "level",
    "level_name"
  ]
}