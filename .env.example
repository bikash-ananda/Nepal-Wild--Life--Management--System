# Copy to .env on the VPS. Generate secrets with: openssl rand -base64 48
POSTGRES_DB=nepal_wildlife
POSTGRES_USER=wildlife
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-48-random-characters
# Required for camera credentials. Generate with: openssl rand -base64 32
CAMERA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# MediaMTX control API service account. Generate the password with: openssl rand -hex 32
MEDIAMTX_API_USER=wildlife-media-control
MEDIAMTX_API_PASSWORD=replace-with-at-least-64-hex-characters
# Optional: comma-separated farm camera subnets reachable through a server VPN, e.g. 10.20.0.0/16
CAMERA_VPN_CIDRS=

APP_ORIGIN=https://bikasheng.com.np
APP_VERSION=1.0.0
SESSION_TTL=12h
ALLOW_SELF_REGISTRATION=false
BOOTSTRAP_ADMIN_EMAIL=admin@bikasheng.com.np
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BOOTSTRAP_ADMIN_NAME=Wildlife Administrator
PGPOOL_MAX=10
MAX_UPLOAD_BYTES=20971520

# Optional SMTP settings for password-reset email and report delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Web Push: generate once from the API project with `npx web-push generate-vapid-keys`.
# Keep the private key secret and stable; changing it requires users to subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bikasheng.com.np
