diff --git a/core/empty_info_test.go b/core/empty_info_test.go
new file mode 100644
--- /dev/null
+++ b/core/empty_info_test.go
@@ -0,0 +1,43 @@
+package core
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRandsaltFromEmptyInfoElement(t *testing.T) {
+	for _, payload := range []string{
+		"<body><Info></Info></body>",
+		"<body><Info/></body>",
+	} {
+		salt, err := randsaltFromInfo([]byte(payload))
+		if err != nil {
+			t.Fatalf("empty Info element should mean no salt: %v", err)
+		}
+		if salt != "" {
+			t.Fatalf("expected empty salt, got %q", salt)
+		}
+	}
+}
+
+func TestRandsaltFromMissingInfoElementFails(t *testing.T) {
+	if _, err := randsaltFromInfo([]byte("<body><DevVersion>6.7</DevVersion></body>")); err == nil {
+		t.Fatal("missing Info element must remain an error")
+	}
+}
+
+func TestAuthOmitsRandSaltWhenEmpty(t *testing.T) {
+	got := getAuthAt("admin", []byte("test-key"), 123, "", "", 1700000000)
+	if strings.Contains(got, "<RandSalt>") {
+		t.Fatalf("empty salt must omit RandSalt XML element: %s", got)
+	}
+	if !strings.Contains(got, "<UserName>admin</UserName>") {
+		t.Fatalf("username missing from auth XML: %s", got)
+	}
+}
+
+func TestAuthIncludesNonEmptyRandSalt(t *testing.T) {
+	got := getAuthAt("admin", []byte("test-key"), 123, "", "abc123", 1700000000)
+	if !strings.Contains(got, "<RandSalt>abc123</RandSalt>") {
+		t.Fatalf("non-empty RandSalt must be preserved: %s", got)
+	}
+}
+